#!/usr/bin/env node
'use strict';

const { parseArgs } = require('node:util');
const pkg = require('../package.json');
const jwt = require('../lib/jwt');
const { Store, defaultCncrc } = require('../lib/config');
const { LibgpiodBackend, MockBackend } = require('../lib/gpio');
const { CncjsClient } = require('../lib/cncjs');
const { App } = require('../lib/app');
const { createServer } = require('../lib/server');

const HELP = `Usage: cncjs-pendant-raspi-gpio [options]

Raspberry Pi GPIO indicators, buttons and actions for CNCjs.

Options:
  -s, --secret <secret>               CNCjs secret key (default: read from the config file,
                                      or the CNCJS_SECRET environment variable)
  -c, --config <filename>             CNCjs config file (default: ~/.cncrc)
      --socket-address <address>      CNCjs address or hostname (default: localhost)
      --socket-port <port>            CNCjs port (default: 8000)
      --access-token-lifetime <time>  access token lifetime in seconds or e.g. 30m, 12h, 30d
                                      (default: 30d)
      --listen-address <address>      address the widget server listens on (default: 127.0.0.1)
      --listen-port <port>            port the widget server listens on (default: 8010)
      --mock                          run without GPIO hardware, for development
  -V, --version                       output the version number
  -h, --help                          output usage information

Then mount the widget in CNCjs:
  cncjs --mount /gpio:http://127.0.0.1:8010/
and add a Custom widget in CNCjs with the URL /gpio/
`;

const log = {
  info: (msg) => console.log(msg),
  warn: (msg) => console.warn(`warning: ${msg}`),
  error: (msg) => console.error(`error: ${msg}`)
};

function options() {
  const { values } = parseArgs({
    options: {
      secret: { type: 'string', short: 's' },
      config: { type: 'string', short: 'c' },
      'socket-address': { type: 'string', default: 'localhost' },
      'socket-port': { type: 'string', default: '8000' },
      'access-token-lifetime': { type: 'string', default: '30d' },
      'listen-address': { type: 'string', default: '127.0.0.1' },
      'listen-port': { type: 'string', default: '8010' },
      mock: { type: 'boolean', default: false },
      version: { type: 'boolean', short: 'V', default: false },
      help: { type: 'boolean', short: 'h', default: false }
    }
  });
  return values;
}

async function main() {
  let opts;
  try {
    opts = options();
    jwt.parseLifetime(opts['access-token-lifetime']);
  } catch (err) {
    console.error(`${err.message}\n\n${HELP}`);
    process.exit(2);
  }
  if (opts.help) {
    console.log(HELP);
    return;
  }
  if (opts.version) {
    console.log(pkg.version);
    return;
  }

  let secret = opts.secret || process.env.CNCJS_SECRET || '';
  const getToken = () => jwt.sign({ id: '', name: 'cncjs-pendant' }, secret, opts['access-token-lifetime']);

  const file = opts.config || defaultCncrc();
  const store = new Store({
    file,
    baseUrl: `http://${opts['socket-address']}:${opts['socket-port']}`,
    getToken,
    log
  });
  secret = secret || store.readSecret();
  if (!secret) {
    log.error(`No CNCjs secret found. Check that ${file} is the config file CNCjs uses ` +
      '(--config), or pass --secret.');
    process.exit(1);
  }

  const backend = opts.mock ? new MockBackend() : new LibgpiodBackend();
  const cncjs = new CncjsClient({
    address: opts['socket-address'],
    port: opts['socket-port'],
    getToken,
    log
  });
  const app = new App({ secret, store, backend, cncjs, mock: opts.mock, log });
  const server = createServer(app);

  let stopping = false;
  const stop = async () => {
    if (stopping) {
      return;
    }
    stopping = true;
    await server.shutdown();
    await app.stop().catch(() => {});
    process.exit(0);
  };
  process.on('SIGINT', stop);
  process.on('SIGTERM', stop);

  await app.start();
  cncjs.connect();

  server.on('error', (err) => {
    log.error(`Widget server: ${err.message}`);
    process.exit(1);
  });
  server.listen(Number(opts['listen-port']), opts['listen-address'], () => {
    log.info(`cncjs-pendant-raspi-gpio ${pkg.version}${opts.mock ? ' (mock GPIO)' : ''} ` +
      `listening on http://${opts['listen-address']}:${opts['listen-port']}/`);
  });
}

main().catch((err) => {
  log.error(err.stack || err.message);
  process.exit(1);
});
